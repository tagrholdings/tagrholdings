# Copy to scraper/.env (git-ignored) for local runs. In GitHub Actions these are
# repository secrets — see .github/workflows/lead-engine.yml.

# Connection string for the `lead_scraper` Postgres role (NOT the app's owner
# role — that one bypasses row-level security). Use the direct (non-pooled)
# host: the job holds one session-level advisory lock for the whole run.
DATABASE_URL_SCRAPER=postgresql://lead_scraper:PASSWORD@HOST/DBNAME?sslmode=require

# One Google Cloud key with Places API (New) and Geocoding API enabled (same
# key the app calls GOOGLE_CLOUD_API_KEY). Custom Search is no longer used.
GOOGLE_CLOUD_API_KEY=

# Brave Search API key — the "Brave Search" source (finds company websites by
# keyword). Get it at https://api-dashboard.search.brave.com/ (Search plan).
# Without it that source is skipped.
BRAVE_API_KEY=

GEMINI_API_KEY=
# Model used for extraction (default gemini-2.5-flash). Cost estimates need a known price — see
# shared/lead-engine-spec.json (pricing.geminiUsdPerMillion).
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# The domain every workspace's leads inbox lives on (the Resend receiving domain, e.g. in.tagrholdings.com).
# Each workspace has its OWN address on it and its OWN buyer identity (who the signups sign up as) - both are read
# per tenant from the database (CRM: Settings > Workspace), so nothing about them is configured here.
# Only needed when an email source is due for an automatic signup.
INBOUND_EMAIL_DOMAIN=

# Optional
# SCRAPER_USER_AGENT=TagrLeadEngine/1.0 (+https://www.tagrholdings.com)
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=
