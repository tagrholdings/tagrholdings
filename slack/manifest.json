{
  "display_information": {
    "name": "TAGR CRM",
    "description": "Tell it a task by text or voice note; it fills in the activity for you to confirm.",
    "background_color": "#1f2937"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "TAGR CRM",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Create CRM task",
        "type": "message",
        "callback_id": "create_task_from_message",
        "description": "Turn this message into a task in the CRM"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "chat:write",
        "commands",
        "im:write",
        "files:read",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://crm.tagrholdings.com/api/slack/events",
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://crm.tagrholdings.com/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
