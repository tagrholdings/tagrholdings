<?xml version="1.0" encoding="utf-8"?>
<!-- Windows/Edge pinned-tile metadata, referenced by the "msapplication-config"
     meta tag in app/layout.tsx. Assets from public/pwa-icons/windows/. -->
<browserconfig>
  <msapplication>
    <tile>
      <square150x150logo src="/pwa-icons/windows/Square150x150Logo.scale-100.png"/>
      <square310x310logo src="/pwa-icons/windows/LargeTile.scale-100.png"/>
      <square70x70logo src="/pwa-icons/windows/SmallTile.scale-100.png"/>
      <wide310x150logo src="/pwa-icons/windows/Wide310x150Logo.scale-100.png"/>
      <TileColor>#1b1d1f</TileColor>
    </tile>
  </msapplication>
</browserconfig>
